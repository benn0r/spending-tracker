{
  "name": "spending-tracker",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:sync": "expo prebuild --platform ios",
    "ios:build": "npm run ios:sync && expo run:ios --device",
    "ios:build:release": "npm run ios:sync && expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint . --max-warnings=0",
    "build": "expo export --platform web --output-dir dist --max-workers 1",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/unit/*.test.ts",
    "test:coverage": "npm run test:unit:coverage && npm run test:components:coverage",
    "test:unit:coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --experimental-test-coverage --test-coverage-include=src/app-model.ts --test-coverage-include=src/dates.ts --test-coverage-include=src/transactions.ts --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 --test tests/unit/*.test.ts",
    "test:components": "jest --runInBand",
    "test:components:coverage": "jest --runInBand --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ios": "node scripts/run-ios-e2e.mjs",
    "test:e2e:ios:mock": "node tests/e2e-ios/mock-server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "expo": "~57.0.9",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.14",
    "expo-file-system": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.16",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.3",
    "serve": "^14.2.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/node_modules/@react-native-async-storage/async-storage/jest/async-storage-mock.js"
    },
    "testMatch": [
      "<rootDir>/tests/components/**/*.test.ts?(x)"
    ],
    "collectCoverageFrom": [
      "App.tsx",
      "src/**/*.{ts,tsx}",
      "!src/app-model.ts",
      "!src/dates.ts",
      "!src/transactions.ts",
      "!src/styles.ts",
      "!src/theme.ts",
      "!src/types.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 55,
        "branches": 45,
        "functions": 50
      }
    }
  }
}
